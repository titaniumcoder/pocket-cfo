# cmd/pocketcfo enforces GitHub OAuth login when this is "prod", and skips auth
# entirely when it is "development". There is no third value: anything else,
# unset included, refuses to boot, because a typo here used to serve the whole
# app — client-portal links and all — to anyone who asked.
export ENV=development

# Which data checkout is mounted, shown under the title in the header. Both
# optional; unset shows nothing. Your data repo's deploy sets these, since the
# data is bind-mounted and only it knows the commit.
export DATA_UPDATED_AT=
export DATA_COMMIT=

export API2PDF_KEY=
# Shared bearer token for the Hermes API. Unset means /api/ is never
# registered at all — the endpoints do not exist rather than returning 401.
export HERMES_API_TOKEN=
# Fine-grained PAT with contents:write on the data repo ONLY. Unset means the
# read endpoints work and writes return 503.
export GITHUB_DATA_TOKEN=
# Both the /api/ endpoints and the /mcp server are gated on HERMES_API_TOKEN.
# Optional, defaults to https://api.github.com — point the Contents client at
# a scratch instance or a stub while verifying the write path.
export GITHUB_API_URL=
# Used by `pocket-cfo-ctl translate` to fill missing Bulgarian text on drafts.
export DEEPL_API_KEY=

# GitHub OAuth login, see internal/auth/github.go and ARCHITECTURE.md §8.
export GITHUB_OAUTH_CLIENT_ID=
export GITHUB_OAUTH_CLIENT_SECRET=
export SESSION_SECRET=
export PUBLIC_BASE_URL=http://localhost:8080
export GITHUB_REPO=titaniumcoder/pocket-cfo

# Separate from SESSION_SECRET: derives the stateless /invoicing/client/{token}
# portal links, see cmd/pocketcfo/client.go. A recipient only gets a working
# link once access_passkey is set on their own data/recipients/NNNN.json.
export CLIENT_LINK_SECRET=

# Email login (read-only access), see cmd/pocketcfo/email_login.go and
# ARCHITECTURE.md §8.
# Signs the self-expiring /auth/email login link, see internal/auth/otp.go.
# Separate from SESSION_SECRET/CLIENT_LINK_SECRET, same
# one-secret-per-mechanism convention.
export OTP_LINK_SECRET=
# Amazon SES sends the /auth/email login link (internal/mail), via the AWS
# SDK's default credential chain — set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# (or rely on an attached IAM role) alongside AWS_REGION below. With
# SES_FROM_EMAIL unset, the link is logged instead of emailed — handy for
# local testing of the email-login flow without real AWS credentials.
# SES_FROM_EMAIL must be a verified SES identity (address or domain).
export AWS_REGION=
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export SES_FROM_EMAIL=

# Finance tracker (internal/finance) — see internal/finance/config.
# Optional: with no Toggl credentials at all the tracked-hours layer is
# disabled entirely (predictions still run off the configured hourly rate
# in config.json — see hourlyRateCents/currency there).
#
# Toggl Track: the API token from its profile page and the workspace id.
export TOGGL_API_TOKEN=
export TOGGL_WORKSPACE_ID=
# Toggl 2.0 (focus.toggl.com): a toggl_sk_… key from its settings page —
# only one is active per user, and it EXPIRES after the period chosen when
# it was generated (30 or 90 days, …). The organization and workspace ids
# come from the app's URL; the 2.0 API has no call to look them up. Once
# Toggl rejects the key, the finance page and /info say so until a new one
# is set here.
export TOGGL2_API_KEY=
export TOGGL2_ORGANIZATION_ID=
export TOGGL2_WORKSPACE_ID=
# Optional, YYYY-MM-DD: the date the 2.0 key expires, for a warning during
# its last seven days rather than only after Toggl starts rejecting it.
export TOGGL2_API_KEY_EXPIRES_AT=
# Which API feeds the dashboard: track, toggl2, or both (hours from the two
# added together — for a migration without live sync). Unset keeps today's
# behaviour: Toggl Track whenever its credentials are present, even beside
# the 2.0 ones, and Toggl 2.0 only when those are the only ones set — so an
# unchanged deployment is unaffected by the variables above.
export TOGGL_MODE=
# Optional, a Go duration, default 15m: how often tracked hours are
# refreshed in the background. Toggl 2.0 counts requests per hour (30 on
# its Free plan), so a Free plan wants 1h.
# export TOGGL_REFRESH_INTERVAL=15m
# Optional. Default to config.json — non-secret finance tunables
# (hoursPerDay, togglProjectIds, toggl2ProjectIds, holidayCountry,
# holidaySubdivision, hourlyRateCents, currency, annualVacationDays) plus
# the four dated blocks: legislation, salary, targetBalance, startMonth.
# See internal/finance/config.FileConfig, which is the reference for every
# field, and README.md's config.json section.
# export CONFIG_FILE=
# Optional. The note catalog the invoice validators check mandatory wording
# against; defaults to catalog in the web app and to catalog beside DATA_DIR
# in pocket-cfo-ctl.
# export CATALOG_DIR=
# Optional, default 8080.
# export PORT=

# Local data/build/template layout — override to point cmd/pocketcfo/
# pocket-cfo-ctl at a data checkout outside this repo (e.g. a separate private
# repo holding real invoicing data), or to swap in a deployment's own
# branding instead of this repo's own templates/logo. DATA_DIR covers
# recipients/, invoices/, users.json, budget.json together (see
# schemas/users.json, internal/users, internal/finance/tracker.Budget).
export BUILD_DIR=build
export DATA_DIR=data
export TEMPLATES_DIR=templates
export STATIC_DIR=static
