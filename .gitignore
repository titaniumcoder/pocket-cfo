# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# go build ./... writes a binary to the repo root if only one main package
# happens to match at build time (e.g. mid-refactor); these are never inputs.
/pocket-cfo-ctl
/pocketcfo

# Generated from JSON Schema by go-jsonschema via `go generate ./...` (see
# internal/schema/generate.go and internal/finance/*data/gen.go). Build
# output, not source: every build regenerates them, so checking them in only
# creates diffs nobody reviews and merge conflicts nobody can resolve.
# `go generate ./...` (or `make generate`) is required before the tree
# compiles from a fresh clone — CI, the Dockerfile and the release workflow
# all run it as their first step.
/internal/finance/budgetdata/generated.go
/internal/finance/accountsdata/generated.go
/internal/finance/actualsdata/generated.go
/internal/schema/issuer/issuer.go
/internal/schema/recipient/recipient.go
/internal/schema/invoice/invoice.go
/internal/schema/notes/notes.go
/internal/schema/users/users.go
/internal/schema/paidinvoices/paidinvoices.go

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
.envrc

# air (https://github.com/air-verse/air) hot-reload scratch dir/log
/tmp/
build-errors.log

# Editor/IDE
# .idea/
# .vscode/
.DS_Store

# Claude Code session-local state, never project content
.claude/scheduled_tasks.lock
