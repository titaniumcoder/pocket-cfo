{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titaniumcoder.com/schemas/invoice.json",
  "title": "Invoice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "number",
    "status",
    "type",
    "title",
    "issue_date",
    "due_date",
    "currency",
    "language",
    "issuer",
    "recipient",
    "lines",
    "tax",
    "annulment"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "number": { "type": "string", "pattern": "^INV-\\d{10}$" },
    "status": { "type": "string", "enum": ["draft", "issued"] },
    "type": { "type": "string", "const": "invoice" },
    "title": { "type": "string", "minLength": 1 },
    "issue_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "language": { "type": "string", "enum": ["de", "en", "fr", "bg"] },
    "issuer": { "$ref": "#/$defs/issuer_snapshot" },
    "recipient": { "$ref": "#/$defs/recipient_snapshot" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line" }
    },
    "discounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/discount" }
    },
    "tax": { "$ref": "#/$defs/tax" },
    "annulment": {
      "type": ["object", "null"],
      "$ref": "#/$defs/annulment"
    }
  },
  "$defs": {
    "localized_string": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "de": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "fr": { "type": "string", "minLength": 1 },
        "bg": { "type": "string", "minLength": 1 }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line1", "postal_code", "city", "country_code"],
      "properties": {
        "line1": { "type": "string", "minLength": 1 },
        "line2": { "type": "string" },
        "postal_code": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "iban", "bic"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "iban": { "type": "string", "minLength": 1 },
        "bic": { "type": "string", "minLength": 1 },
        "intermediary_bic": { "type": "string" }
      }
    },
    "issuer_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "address", "tax_id", "vat_id", "bank", "default_currency"],
      "properties": {
        "legal_name": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "tax_id": { "type": "string", "minLength": 1 },
        "vat_id": { "type": "string", "minLength": 1 },
        "bank": { "$ref": "#/$defs/bank" },
        "logo": { "type": "string" },
        "default_currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "recipient_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "legal_name",
        "address",
        "is_business",
        "language",
        "payment_terms_days",
        "email"
      ],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "legal_name": { "type": "string", "minLength": 1 },
        "address": { "$ref": "#/$defs/address" },
        "tax_id": { "type": "string" },
        "vat_id": { "type": "string" },
        "is_business": { "type": "boolean" },
        "language": { "type": "string", "enum": ["de", "en", "fr", "bg"] },
        "payment_terms_days": { "type": "integer", "minimum": 0 },
        "email": { "type": "string", "format": "email" }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "unit_price", "vat_rate"],
      "properties": {
        "description": { "$ref": "#/$defs/localized_string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string" },
        "unit_price": { "type": "integer" },
        "vat_rate": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "discount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": { "$ref": "#/$defs/localized_string" },
        "percent": { "type": "integer", "minimum": 0 },
        "amount": { "type": "integer" }
      },
      "oneOf": [
        { "required": ["percent"], "not": { "required": ["amount"] } },
        { "required": ["amount"], "not": { "required": ["percent"] } }
      ]
    },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regime", "citations", "note"],
      "properties": {
        "regime": {
          "type": "string",
          "enum": ["domestic_standard", "eu_b2b_reverse_charge", "outside_eu_place_of_supply"]
        },
        "citations": { "type": "array", "items": { "type": "string" } },
        "note": { "$ref": "#/$defs/localized_string" }
      }
    },
    "annulment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "reason_de", "reason_bg"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "reason_de": { "type": "string", "minLength": 1 },
        "reason_bg": { "type": "string", "minLength": 1 },
        "replacement_invoice": { "type": "string", "pattern": "^INV-\\d{10}$" }
      }
    }
  }
}
